# =============================================================================
# Meridian — Render env var reference
# =============================================================================
# Grouped per service. Anything marked "generated" is set by Render on first
# deploy (via `generateValue: true` in render.yaml) — you don't paste it.
# Anything marked "you supply" needs a real value; Render's dashboard prompts
# for each on first Blueprint apply because they use `sync: false`.
# -----------------------------------------------------------------------------


# ─────────────────────────────────────────────────────────────────────────────
# meridian-db (managed Postgres)
# ─────────────────────────────────────────────────────────────────────────────
# Nothing to paste. Render provisions this and injects DATABASE_URL into the
# api service automatically (via the `fromDatabase` binding in render.yaml).


# ─────────────────────────────────────────────────────────────────────────────
# meridian-ml (private service — no public URL)
# ─────────────────────────────────────────────────────────────────────────────
PYTHON_VERSION=3.11.9
PORT=8000
LOG_LEVEL=info
ENV=production
ALLOW_TRAIN_ON_BOOT=no
ALLOWED_ORIGINS=                        # keep empty; API calls it server→server


# ─────────────────────────────────────────────────────────────────────────────
# meridian-api (public Node service)
# ─────────────────────────────────────────────────────────────────────────────
NODE_VERSION=20.11.1
NODE_ENV=production
PORT=10000
TRUST_PROXY=true
LOG_LEVEL=info

# Auto-populated
DATABASE_URL=                           # from meridian-db binding
DATABASE_SSL=true
JWT_SECRET=                             # generated by Render (32+ chars)
SESSION_SECRET=                         # generated by Render
GITHUB_WEBHOOK_SECRET=                  # generated by Render — copy into GitHub App

# Internal wiring — leave as-is; matches the pserv name.
ML_SERVICE_URL=http://meridian-ml:8000

# YOU SUPPLY — updated AFTER first deploy once Render assigns the web URL.
WEB_ORIGIN=https://meridian-web.onrender.com
ALLOWED_ORIGINS=https://meridian-web.onrender.com
COOKIE_DOMAIN=                          # leave blank unless using a custom apex

# YOU SUPPLY — GitHub App / OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=https://meridian-api.onrender.com/auth/github/callback
GITHUB_APP_ID=

# YOU SUPPLY — admin bootstrap
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=                         # pick a strong one; used only for db:seed

# Optional integrations
SLACK_WEBHOOK_URL=
EMAIL_PROVIDER=                         # e.g. "resend"
EMAIL_FROM=alerts@yourcompany.com
RESEND_API_KEY=

# Rate limits (defaults fine)
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=300

# Never enable in prod
ALLOW_UNSIGNED_WEBHOOKS=false
FORCE_DEMO_SEED=no


# ─────────────────────────────────────────────────────────────────────────────
# meridian-web (static site)
# ─────────────────────────────────────────────────────────────────────────────
NODE_VERSION=20.11.1

# Build-time only. After first deploy set to the API service URL.
VITE_API_BASE=https://meridian-api.onrender.com
