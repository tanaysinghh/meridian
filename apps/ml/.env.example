# =============================================================================
# Meridian ML — environment template
# Copy to `.env` for local dev, or set each var on your host. Values here match
# the keys render.yaml provisions for the meridian-ml service.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
PORT=8000
LOG_LEVEL=info                   # debug | info | warning | error
ENV=development                  # set to `production` in prod (enables strict boot checks)

# --- Model bootstrap ---------------------------------------------------------
# Model.pkl is normally baked at build time (see render.yaml buildCommand).
# Set to `yes` to auto-train on first request if the artifact is missing.
# Refused in production unless explicitly opted in.
ALLOW_TRAIN_ON_BOOT=yes

# --- Shared-secret gate ------------------------------------------------------
# Required in production. The API must send this in the `X-Internal-Secret`
# header on every /score request. Blank in local dev is fine.
ML_INTERNAL_SECRET=

# --- CORS --------------------------------------------------------------------
# Comma-separated allowed browser origins. Default empty — the ML service is
# server-to-server only.
ALLOWED_ORIGINS=
