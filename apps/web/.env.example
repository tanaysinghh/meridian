# =============================================================================
# Meridian Web — environment template
# Copy to `.env` for local dev. Vite bakes these into the bundle at BUILD time
# (not runtime), so a rebuild is required after changing them.
# =============================================================================

# Base URL of the meridian-api service.
# - Local dev: leave unset — Vite's dev server proxies /api and /socket.io to
#   http://localhost:4000 (see vite.config.js).
# - Production: set to the api's public URL, e.g. https://meridian-api.onrender.com
VITE_API_BASE=
