# =============================================================================
# Meridian API — environment template
# Copy to `.env` for local dev, or provision each key in your host's secret
# manager for staging/prod. `.env` is gitignored — never commit real secrets.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug                  # debug | info | warn | error
TRUST_PROXY=false                # set true when behind an ingress/load balancer

# --- CORS / frontend ---------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
# Comma-separated list of allowed origins. Defaults to WEB_ORIGIN. Never use *.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgres://meridian:meridian@localhost:5433/meridian
DATABASE_SSL=false               # set true for managed Postgres (Neon/RDS/Supabase)
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# --- Auth / crypto -----------------------------------------------------------
# In production: must be at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_COST=12                   # 12 in prod; drop to 4-8 in tests for speed

# --- Bootstrap admin (used by `npm run db:seed`) -----------------------------
# In production these are REQUIRED — seed refuses without them.
ADMIN_EMAIL=
ADMIN_PASSWORD=                  # min 12 chars
ADMIN_NAME=
ADMIN_GITHUB_LOGIN=
ORG_NAME=Meridian
ORG_SLUG=meridian

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AUTH_WINDOW_MS=900000    # 15 min
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000      # 1 min
RATE_LIMIT_API_MAX=300

# --- ML scoring service ------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
# Shared secret required by the ML service's `X-Internal-Secret` check.
# Must match ML_INTERNAL_SECRET on the ml service. Blank in local dev is fine
# only if the ml service is also running without one.
ML_INTERNAL_SECRET=

# --- GitHub App / OAuth ------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=             # REQUIRED in prod — webhooks rejected without it
GITHUB_CLIENT_ID=                  # for OAuth login
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:4000/auth/github/callback

# Dev-only: allow unsigned webhooks for local fixture replay. NEVER set in prod.
# ALLOW_UNSIGNED_WEBHOOKS=true

# --- Slack -------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Email (weekly digest) ---------------------------------------------------
EMAIL_PROVIDER=                    # currently supported: resend
EMAIL_FROM=
RESEND_API_KEY=
