# =============================================================================
# Meridian API — environment template (Spring Boot)
#
# Copy to `.env` for local dev, or provision each key in your host's secret
# manager for staging/prod. `.env` is gitignored — never commit real secrets.
#
# Variable names are unchanged from the previous Node service, so an existing
# Render environment or local `.env` carries over as-is. Each one maps to a
# property in application.yml; see that file for the binding.
#
# Spring reads plain environment variables, not this file, so for local dev
# either export these or use a tool that loads .env into the environment
# (the README shows both).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# Selects application-dev.yml or application-prod.yml.
SPRING_PROFILES_ACTIVE=dev
PORT=4000
LOG_LEVEL=debug                  # trace | debug | info | warn | error
TRUST_PROXY=false                # set true when behind an ingress/load balancer

# --- CORS / frontend ---------------------------------------------------------
WEB_ORIGIN=http://localhost:5173
# Comma-separated list of allowed origins. Defaults to WEB_ORIGIN. Never use *.
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# SameSite attribute on the auth and CSRF cookies. The dev profile uses Lax;
# the prod profile defaults to None, because the deployed web and api hosts are
# different *sites* and a Lax cookie would never be sent. Only override this to
# tighten back to Lax when both sit under one apex domain. None requires
# Secure, which the prod profile sets unconditionally.
# COOKIE_SAME_SITE=None

# --- Database ----------------------------------------------------------------
# Accepted in either the libpq URI form below (what Render and docker-compose
# emit) or the JDBC form `jdbc:postgresql://host:port/db`. The URI form is
# converted at startup — see config/DatabaseUrl.java.
DATABASE_URL=postgres://meridian:meridian@localhost:5433/meridian
DATABASE_SSL=false               # true for managed Postgres (Neon/RDS/Supabase)
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# --- Auth / crypto -----------------------------------------------------------
# In production: required, and must be at least 32 chars — the app refuses to
# start otherwise. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m               # Spring duration format: 15m, 1h, 30s
JWT_REFRESH_TTL_DAYS=30
BCRYPT_COST=12                   # 12 in prod; drop to 4-8 in tests for speed

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AUTH_WINDOW_MS=900000    # 15 min
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000      # 1 min
RATE_LIMIT_API_MAX=300

# --- ML scoring service ------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
# Shared secret required by the ML service's `X-Internal-Secret` check.
# Must match ML_INTERNAL_SECRET on the ml service. Blank in local dev is fine
# only if the ml service is also running without one.
ML_INTERNAL_SECRET=

# --- GitHub App / OAuth ------------------------------------------------------
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=             # REQUIRED in prod — the app refuses to start without it
GITHUB_CLIENT_ID=                  # for OAuth login
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:4000/auth/github/callback

# Dev-only: allow unsigned webhooks for local fixture replay. Refused under the
# prod profile — the app will not start with it enabled.
# ALLOW_UNSIGNED_WEBHOOKS=true

# --- Bootstrap admin ---------------------------------------------------------
# Used only when the app is started with `--seed` (or MERIDIAN_SEED=true), which
# creates the first org and its admin user and then serves as normal.
# In production these are REQUIRED for that run — it refuses to invent a default
# administrator. Password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_GITHUB_LOGIN=
ORG_NAME=Meridian
ORG_SLUG=meridian

# --- Demo dataset ------------------------------------------------------------
# `--seed-demo` (or MERIDIAN_SEED_DEMO=true) loads the sample Acme dataset into
# the org `--seed` just created. It clears its own rows first, so leaving it set
# means every restart wipes whatever has accumulated since. Under the prod
# profile it additionally refuses to run without FORCE_DEMO_SEED=yes.
# MERIDIAN_SEED_DEMO=true
# FORCE_DEMO_SEED=yes

# --- Slack -------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Email (weekly digest) ---------------------------------------------------
EMAIL_PROVIDER=                    # currently supported: resend
EMAIL_FROM=
RESEND_API_KEY=

# =============================================================================
# Notes on variables that no longer apply
#
#   NODE_ENV     -> replaced by SPRING_PROFILES_ACTIVE (dev | prod)
#   NODE_VERSION -> the service is a Docker image now; the JDK is in the image
#
# `npm run db:seed:demo` -> `--seed-demo` / MERIDIAN_SEED_DEMO (see above)
# =============================================================================
